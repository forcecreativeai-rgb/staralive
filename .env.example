# ─── StarAlive Environment Variables ───────────────────────────────────────
# NEVER commit actual keys. Copy this file to .env.local and fill in values.
# All API calls MUST go through /api/ serverless functions — never expose keys
# in frontend code or VITE_ prefixed variables.

# OpenAI — Image generation (gpt-image-1)
# Set in Vercel: Settings → Environment Variables → OPENAI_API_KEY
OPENAI_API_KEY=

# Google Gemini — Video generation (Veo 3.1)
# Set in Vercel: Settings → Environment Variables → GEMINI_API_KEY
GEMINI_API_KEY=

# Stingray Karaoke API (pending partnership)
# Request credentials at: karaoke-api-doc.stingray.com
# These go in serverless functions ONLY — never in frontend
STINGRAY_CLIENT_ID=
STINGRAY_CLIENT_SECRET=
