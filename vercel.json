{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate-image.js":  { "maxDuration": 60 },
    "api/analyze-photo.js":   { "maxDuration": 20 },
    "api/generate-video.js":  { "maxDuration": 300 }
  }
}
